# =============================================================================
# .env.release.example — minimal env for `docker compose -f docker-compose.release.yml`
#
# Copy this file to `.env.release` (next to docker-compose.release.yml) and
# fill in the four secrets at minimum. The release container will exit 1 on
# boot in any NODE_ENV if any of the four are missing, whitespace, or set
# to a banned placeholder (per src/lib/validate-secrets.js).
#
# Generate each secret with:
#   openssl rand -hex 32
# =============================================================================

# ─────── Image + ports ───────
# Default image is ghcr.io/valerok/myapi-open:v0.6.0. Override only if
# you maintain your own GHCR mirror or want to track :latest.
GHCR_OWNER=valerok
IMAGE_TAG=v0.6.0
PORT_BIND=4500

# ─────── REQUIRED secrets — generate fresh, never reuse across instances ───────
SESSION_SECRET=
JWT_SECRET=
ENCRYPTION_KEY=
VAULT_KEY=

# ─────── Operational ───────
NODE_ENV=production
LOG_LEVEL=info

# ─────── Reverse-proxy / cookie / origin (set when behind a real proxy) ───────
# TRUSTED_PROXIES=loopback
# ALLOWED_ORIGINS=https://your-domain.com
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_DOMAIN=.your-domain.com
# BASE_URL=https://your-domain.com
# PUBLIC_URL=https://your-domain.com

# ─────── OAuth providers (enable only what you need) ───────
# ENABLE_OAUTH_GOOGLE=true
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-domain.com/api/v1/oauth/callback/google

# ENABLE_OAUTH_GITHUB=true
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=https://your-domain.com/api/v1/oauth/callback/github

# Other providers: see src/.env.example for the full ENABLE_OAUTH_* set.

# ─────── Email (optional — only needed for notifications) ───────
# EMAIL_PROVIDER=resend
# EMAIL_FROM=noreply@your-domain.com
# EMAIL_FROM_NAME=MyApi
# RESEND_API_KEY=

# ─────── Owner ───────
# POWER_USER_EMAIL=owner@your-domain.com
